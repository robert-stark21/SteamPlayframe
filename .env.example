# Copy to .env and fill in. Never commit .env.

# SQLite file. Use a path on a persistent disk in production.
DATABASE_PATH=./data/playframe.db

# API server port (the Vite dev server proxies /api to it).
API_PORT=8787

# Optional. With a Steam Web API key the sync walks the full app list via
# IStoreService/GetAppList. Without it the sync starts from the public
# most-played chart plus SYNC_SEED_APPIDS.
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Comma-separated extra appids to always include in a sync.
SYNC_SEED_APPIDS=

# Stop after this many apps per sync run (0 = no limit). The checkpoint lets
# the next run continue where this one stopped.
SYNC_LIMIT=500

# Steam store country and language for metadata.
STEAM_COUNTRY=US
STEAM_LANGUAGE=english

# Pause between storefront appdetails calls, in ms. Valve throttles this
# endpoint (roughly 200 calls per 5 minutes); keep it at 1500 or more.
STEAM_DETAILS_DELAY_MS=1600

# Optional. DNS servers (comma-separated) used only for Steam store requests
# (descriptions, screenshots), for networks whose resolver does not answer for Steam.
# Example: STEAM_DNS=1.1.1.1
STEAM_DNS=

# "Buy me a coffee" block (filter column on desktop, page footer on phones).
# Read at build time; with neither set, the block is hidden.
# VITE_DONATE_URL: your donate page, e.g. https://buymeacoffee.com/yourname (the QR is drawn from it)
# VITE_DONATE_QR_IMAGE: optional image in public/, e.g. /donate-qr.png, shown instead of the drawn QR
VITE_DONATE_URL=
VITE_DONATE_QR_IMAGE=
